{
    "name": "consorciohive/simac_webservice",
    "description": "Sistema local distribuido para clinicas - sincronizacion con SIMAC nube",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^2.0",
        "phpmailer/phpmailer": "^6.9",
        "phpoffice/phpspreadsheet": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "vendor-dir": "vendor",
        "audit": {
            "block-insecure": false
        }
    }
}
